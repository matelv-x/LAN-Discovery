{
  "maintenance_contract": 1,
  "uninstall_contract": 2,
  "id": "lan-discovery",
  "name": "LAN Discovery",
  "repository": "matelv-x/LAN-Discovery",
  "platforms": ["v4"],
  "detect": {"all": [{"path": "classes/stargate_address_book.py", "contains": "lan_gates"}, {"path": "web/retro/js/address_book.js", "contains": "lan"}]},
  "install": {"argv": ["./langate.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
  "uninstall": {"argv": ["./restore-langate.sh"], "env": {"APP_DIR": "{sg1_root}"}, "timeout": 900},
  "archive_integration_files": ["classes/web_server.py", "web/retro/address_book.html", "web/js/address_book.js"],
  "restart_required": true
}
